// Cloudflare Workers の設定。
// 画面は静的ファイルとして配信し、/api/* だけ worker/index.js が動く。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team3",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "run_worker_first": ["/api/*"]
  },
  // 心拍の中継（worker/heartRelay.js）
  "durable_objects": {
    "bindings": [{ "name": "HEART_RELAY", "class_name": "HeartRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HeartRelay"] }]
}
